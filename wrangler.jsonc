{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "ai-tools-hub",
	"account_id": "f42bab346dd367772b859bec5f7d4611",
	"compatibility_date": "2025-09-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	// wrangler의 esbuild는 keepNames가 기본 true라 함수 본문에 __name(fn,"fn") 호출을
	// 끼워넣는다. next-themes는 테마 초기화 함수를 script.toString()으로 직렬화해
	// <head> 인라인 스크립트로 심는데, 브라우저에는 __name 헬퍼가 없어서
	// "ReferenceError: __name is not defined"로 죽고 하이드레이션 전 테마 적용이
	// 통째로 건너뛰어졌다(다크모드 깜빡임). 이 옵션으로 계측 자체를 끈다.
	"keep_names": false,
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"r2_buckets": [
		{ "binding": "BLOG_ASSETS", "bucket_name": "blog-assets" }
	],
	"vars": {
		"NEXT_PUBLIC_SUPABASE_URL": "https://wgnlsmiicynpizkbzyvu.supabase.co",
		"NEXT_PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6IndnbmxzbWlpY3lucGl6a2J6eXZ1Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzI3OTE2ODEsImV4cCI6MjA4ODM2NzY4MX0.B_OsKIEXG7IBgDdN5ZwVd2dUahXvOh7rQfx5m3ZxEME",
		"NOTION_BLOG_DATABASE_ID": "5192b2c877a34a3881c060927f19e5ac"
	}
	// ADMIN_PASSWORD는 아래 명령어로 별도 설정 필요 (git에 저장 금지):
	// npx wrangler secret put ADMIN_PASSWORD
}
